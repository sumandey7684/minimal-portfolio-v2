{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sumandey.tech" }],
      "destination": "https://www.sumandey.tech/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sumandey.tech" }],
      "destination": "https://www.sumandey.tech/:path*",
      "permanent": true
    }
  ]
}
