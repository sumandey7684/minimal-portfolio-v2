{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sumandey.tech" }],
      "destination": "https://www.sumandey.tech/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sumandey.tech" }],
      "destination": "https://www.sumandey.tech/:path*",
      "statusCode": 301
    }
  ]
}
